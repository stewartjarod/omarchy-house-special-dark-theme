# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#010101"

# Main text color
theme[main_fg]="#bac2de"

# Title color for boxes
theme[title]="#bac2de"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#cba6f7"

# Background color of selected item in processes box
theme[selected_bg]="#313244"

# Foreground color of selected item in processes box
theme[selected_fg]="#cba6f7"

# Color of inactive/disabled text
theme[inactive_fg]="#7f849c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f2cdcd"

# Background color of the percentage meters
theme[meter_bg]="#010101"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f2cdcd"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#cba6f7" #Mauve
theme[mem_box]="#a6e3a1" #Green
theme[net_box]="#eba0ac" #Maroon
theme[proc_box]="#cba6f7"

# Box divider line and small boxes line color
theme[div_line]="#6c7086"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8fc38a"
theme[temp_mid]="#d6c296"
theme[temp_end]="#d57c93"

# CPU graph colors (Teal -> Sapphire -> Lavender)
theme[cpu_start]="#7fc2b7"
theme[cpu_mid]="#64abcb"
theme[cpu_end]="#9ba3da"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#af8fd4"
theme[free_mid]="#9ba3da"
theme[free_end]="#769bd7"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#64abcb"
theme[cached_mid]="#769bd7"
theme[cached_end]="#9ba3da"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#d79a74"
theme[available_mid]="#ca8a94"
theme[available_end]="#d57c93"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#8fc38a"
theme[used_mid]="#7fc2b7"
theme[used_end]="#76bdca"

# Download graph colors (Peach -> Red)
theme[download_start]="#d79a74"
theme[download_mid]="#ca8a94"
theme[download_end]="#d57c93"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#8fc38a"
theme[upload_mid]="#7fc2b7"
theme[upload_end]="#76bdca"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Lavender -> Mauve)
theme[process_start]="#64abcb"
theme[process_mid]="#9ba3da"
theme[process_end]="#af8fd4"
